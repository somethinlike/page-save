{
  "name": "page-save",
  "version": "0.1.1",
  "type": "module",
  "license": "CC0-1.0",
  "description": "Give LLM coding assistants the ability to save and read any browser tab, even sites that block automation. Chrome Extension + Node.js bridge.",
  "bin": {
    "page-save": "bin/page-save.js",
    "page-save-mcp": "bin/page-save-mcp.js"
  },
  "files": [
    "dist/",
    "bin/page-save.js",
    "bin/page-save-mcp.js",
    "bin/page-save-launcher.bat",
    "bin/page-save-server-start.bat",
    "bin/page-save-server-start.vbs",
    "bin/page-save-url-launcher.vbs",
    "extension/",
    "src/native-host-wrapper.cs",
    "README.md",
    "CONTRIBUTING.md",
    "PRIVACY.md",
    "SCHEMA-CONVENTIONS.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "llm",
    "browser",
    "page-save",
    "mhtml",
    "chrome-extension",
    "websocket",
    "csp-bypass"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somethinlike/page-save.git"
  },
  "author": "Ryan Wills <somethinlike@gmail.com>",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "serve": "npm run build && node dist/cli.js serve",
    "tabs": "npm run build && node dist/cli.js tabs",
    "save": "npm run build && node dist/cli.js save",
    "text": "npm run build && node dist/cli.js text",
    "mcp": "npm run build && node dist/mcp-server.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "linkedom": "^0.18.13",
    "typescript": "^5.8.0",
    "vitest": "^4.1.2"
  }
}
